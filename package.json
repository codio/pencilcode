    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "http-proxy": "^1.18.1",
    "log-timestamp": "^0.3.0",
    "parseurl": "^1.3.3",
    "seedrandom": "^3.0.5",
    "source-map": "^0.8.0",
    "tamper": "^1.1.0"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "browserify-shim": "^3.8.16",
